{
  "name": "sage",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "evals"],
  "scripts": {
    "sage": "bun run packages/cli/src/bin.ts",
    "test": "bun test",
    "lint": "bun run scripts/lint.ts",
    "lint:fix": "bun run scripts/lint.ts --write",
    
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "disk": "bun run scripts/disk-usage.ts",
    "demo": "bun run scripts/demo.ts",
    "probe": "bun run scripts/engine-probe.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@biomejs/js-api": "6.1.0",
    "@biomejs/wasm-nodejs": "2.6.8",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
